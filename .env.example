# GitHub Actions — set in repo Secrets for automated retraining
GITHUB_REPO=your-username/autonomous-ml-platform
GITHUB_TOKEN=ghp_xxxxxxxxxxxx

# Optional: remote MLflow for CI retraining
MLFLOW_TRACKING_URI=http://your-mlflow-host:5000

# Webhook secret (must match backend RETRAIN_WEBHOOK_SECRET)
RETRAIN_WEBHOOK_SECRET=change-me-in-production
